{
  "name": "khmer-launcher",
  "version": "1.2.0",
  "description": "KHMER LAUNCHER - Minecraft 1.21.1 Multi-Account & In-Game PvP Editor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "release": "electron-builder --win -p always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^4.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.khmer.launcher",
    "productName": "KHMER LAUNCHER",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "bundled_mods/**/*",
      "!**/*.exe",
      "!dist/**",
      "!SimplePvPMod/**",
      "!SimplePvP-Mod/**",
      "!PvPLauncher/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Dara13144",
        "repo": "Khmer-luncher.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/khmer_launcher_logo.png"
    },
    "nsis": {
      "artifactName": "KHMER-Launcher-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KHMER LAUNCHER"
    },
    "portable": {
      "artifactName": "KHMERLUNCHER.exe"
    }
  }
}
